{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " \u279c  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "31"
    },
    {
      "type": "kernel",
      "key": " \u251c \uf093 ",
      "keyColor": "31"
    },
    {
      "type": "shell",
      "key": " \u251c \uf489 ",
      "keyColor": "31"
    },
    {
      "type": "uptime",
      "key": " \u2514 \ue312 ",
      "format": "{1}:{2}:{3}",
      "keyColor": "31"
    },
    "break",
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "32"
    },
    {
      "type": "terminal",
      "key": " \u251c \ue795 ",
      "keyColor": "32"
    },
    {
      "type": "terminalfont",
      "key": " \u2514 \uf031 ",
      "keyColor": "32"
    },
    "break",
    {
      "type": "host",
      "key": "PC   ",
      "keyColor": "33"
    },
    {
      "type": "cpu",
      "format": "{1} ({3} cores)",
      "key": " \u251c \uf4bc ",
      "keyColor": "33"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": " \u251c \uf2db ",
      "keyColor": "33"
    },
    {
      "type": "memory",
      "key": " \u251c \uefc5 ",
      "keyColor": "33"
    },
    {
      "type": "swap",
      "key": " \u251c \uf0ec ",
      "keyColor": "33"
    },
    {
      "type": "disk",
      "key": " \u251c \uf0a0 ",
      "keyColor": "33"
    },
    {
      "type": "display",
      "key": " \u2514 \uf108 ",
      "keyColor": "33"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break",
    "break"
  ]
}
