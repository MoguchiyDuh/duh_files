#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Theme control plane: resolves a profile, drives wallust, emits tokens and consumer configs."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import tomllib
from dataclasses import dataclass
from pathlib import Path
from typing import Any

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "duhshell"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "duhshell"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "duhshell"

PROFILES = CONFIG / "profiles"
ANIMATIONS = CONFIG / "animations"
TEMPLATES = CONFIG / "templates"
STATE_FILE = STATE / "state.json"
TOKENS_FILE = CACHE / "tokens.json"
COLORS_FILE = CACHE / "colors.json"

COLOR_SLOTS = tuple(f"color{i}" for i in range(16))

SEMANTIC_ANCHORS = {
    "error": "#E5484D",
    "warning": "#F5A524",
    "success": "#30A46C",
    "info": "#0091FF",
}

WALLUST_TARGETS = (
    ("colors", "colors.json", CACHE / "colors.json"),
    ("btop", "btop-colors.theme", "~/.config/btop/themes/wallust.theme"),
    ("cava", "cava-colors", "~/.config/cava/config"),
    ("swaync", "swaync-colors.css", "~/.config/swaync/colors.css"),
    ("gtk3", "gtk-colors.css", "~/.config/gtk-3.0/colors.css"),
    ("gtk4", "gtk4-colors.css", "~/.config/gtk-4.0/colors.css"),
    ("qt5ct", "qt5ct-colors.conf", "~/.config/qt5ct/colors/wallust.conf"),
    ("qt6ct", "qt5ct-colors.conf", "~/.config/qt6ct/colors/wallust.conf"),
    ("tmux", "tmux-colors.conf", "~/.config/tmux/colors.conf"),
    ("gitmux", "gitmux.conf", "~/.config/tmux/gitmux.conf"),
    ("firefox", "firefox-colors.css", "~/.config/firefox/colors.css"),
    ("fastfetch", "fastfetch-colors.jsonc", "~/.config/fastfetch/config.jsonc"),
    ("nvim", "nvim-colors.lua", CACHE / "nvim.lua"),
    ("p10k", "p10k-colors.zsh", "~/.config/zsh/p10k-colors.zsh"),
)


class ThemeError(Exception):
    """Fatal, user-facing theme operation failure."""


def warn(msg: str) -> None:
    """Emit a non-fatal diagnostic."""
    print(f"duhtheme: warning: {msg}", file=sys.stderr)


def info(msg: str) -> None:
    """Emit a progress line."""
    print(f"duhtheme: {msg}", file=sys.stderr)


def _run(cmd: list[str], *, timeout: int = 30) -> tuple[bool, str]:
    if not shutil.which(cmd[0]):
        return False, f"{cmd[0]} not found"
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout, check=False
        )
    except subprocess.TimeoutExpired:
        return False, f"{cmd[0]} timed out after {timeout}s"
    except OSError as exc:
        return False, f"{cmd[0]} failed to start: {exc}"
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()
        return False, f"{cmd[0]} exited {proc.returncode}: {detail[-1] if detail else 'no output'}"
    return True, proc.stdout


def _write_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(content)
        os.replace(tmp, path)
    except OSError:
        Path(tmp).unlink(missing_ok=True)
        raise


def _load_toml(path: Path) -> dict[str, Any]:
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except FileNotFoundError:
        raise ThemeError(f"missing file: {path}") from None
    except tomllib.TOMLDecodeError as exc:
        raise ThemeError(f"invalid TOML in {path}: {exc}") from None
    except OSError as exc:
        raise ThemeError(f"cannot read {path}: {exc}") from None


def _hex_to_rgb(value: str) -> tuple[int, int, int]:
    raw = value.lstrip("#")
    if len(raw) != 6:
        raise ThemeError(f"expected 6-digit hex color, got {value!r}")
    try:
        return int(raw[0:2], 16), int(raw[2:4], 16), int(raw[4:6], 16)
    except ValueError:
        raise ThemeError(f"invalid hex color {value!r}") from None


def _rgb_to_hex(rgb: tuple[int, int, int]) -> str:
    return "#{:02X}{:02X}{:02X}".format(*rgb)


def _tint(value: str, amount: float) -> str:
    r, g, b = _hex_to_rgb(value)
    t = max(0.0, min(1.0, amount))
    return _rgb_to_hex(
        (
            round(r + (255 - r) * t),
            round(g + (255 - g) * t),
            round(b + (255 - b) * t),
        )
    )


def _blend(base: str, other: str, amount: float) -> str:
    br, bg, bb = _hex_to_rgb(base)
    orr, og, ob = _hex_to_rgb(other)
    t = max(0.0, min(1.0, amount))
    return _rgb_to_hex(
        (
            round(br + (orr - br) * t),
            round(bg + (og - bg) * t),
            round(bb + (ob - bb) * t),
        )
    )


def _relative_luminance(value: str) -> float:
    channels = []
    for raw in _hex_to_rgb(value):
        c = raw / 255
        channels.append(c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4)
    r, g, b = channels
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _contrast(a: str, b: str) -> float:
    la, lb = _relative_luminance(a), _relative_luminance(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


@dataclass(frozen=True)
class State:
    """Persisted selection of profile, animation preset and wallpaper."""

    profile: str
    animation: str | None
    wallpaper: str | None

    @staticmethod
    def load() -> State:
        """Read persisted state, falling back to defaults when absent or corrupt."""
        try:
            raw = json.loads(STATE_FILE.read_text())
        except FileNotFoundError:
            raw = {}
        except (json.JSONDecodeError, OSError) as exc:
            warn(f"state unreadable ({exc}); using defaults")
            raw = {}
        if not isinstance(raw, dict):
            raw = {}
        return State(
            profile=str(raw.get("profile") or "pills"),
            animation=raw.get("animation") or None,
            wallpaper=raw.get("wallpaper") or None,
        )

    def save(self) -> None:
        """Persist state atomically."""
        payload = {
            "profile": self.profile,
            "animation": self.animation,
            "wallpaper": self.wallpaper,
        }
        _write_atomic(STATE_FILE, json.dumps(payload, indent=2) + "\n")


def available_profiles() -> list[str]:
    """Return sorted names of every profile with a readable TOML definition."""
    if not PROFILES.is_dir():
        return []
    return sorted(p.stem for p in PROFILES.glob("*.toml"))


def available_animations() -> list[str]:
    """Return sorted names of every animation preset."""
    if not ANIMATIONS.is_dir():
        return []
    return sorted(p.stem for p in ANIMATIONS.glob("*.toml"))


def load_profile(name: str) -> dict[str, Any]:
    """Load and validate a profile definition."""
    path = PROFILES / f"{name}.toml"
    if not path.is_file():
        known = ", ".join(available_profiles()) or "none found"
        raise ThemeError(f"unknown profile {name!r}; available: {known}")
    profile = _load_toml(path)
    for section in ("meta", "color", "font", "toolkit", "shape", "spacing", "effect", "shell"):
        if section not in profile:
            raise ThemeError(f"profile {name!r} is missing required section [{section}]")
    return profile


def load_animation(name: str) -> dict[str, Any]:
    """Load an animation preset, falling back to a disabled preset when missing."""
    path = ANIMATIONS / f"{name}.toml"
    if not path.is_file():
        known = ", ".join(available_animations()) or "none found"
        warn(f"unknown animation preset {name!r} (available: {known}); animations disabled")
        return {"meta": {"name": "none", "enabled": False}, "curves": {}, "animations": {}}
    return _load_toml(path)


def _wallust_config(profile: dict[str, Any]) -> str:
    color = profile["color"]
    lines = [
        f'backend = "{color.get("backend", "fastresize")}"',
        f'color_space = "{color.get("color_space", "lchmixed")}"',
        f'palette = "{color.get("palette", "dark16")}"',
    ]
    if "threshold" in color:
        lines.append(f'threshold = {int(color["threshold"])}')
    if color.get("check_contrast"):
        lines.append("check_contrast = true")
    if "saturation" in color:
        lines.append(f'saturation = {int(color["saturation"])}')
    lines.append("")
    lines.append("[templates]")
    for name, template, target in WALLUST_TARGETS:
        if not (TEMPLATES / template).is_file():
            warn(f"template missing, skipping {name}: {template}")
            continue
        lines.append(f'{name}.template = "{template}"')
        lines.append(f'{name}.target = "{target}"')
    return "\n".join(lines) + "\n"


def run_wallust(profile: dict[str, Any], wallpaper: str | None) -> None:
    """Generate the palette for the given wallpaper using the profile's wallust settings."""
    config_path = CACHE / "wallust.toml"
    _write_atomic(config_path, _wallust_config(profile))
    CACHE.mkdir(parents=True, exist_ok=True)

    cmd = [
        "wallust",
        "-C",
        str(config_path),
        "--templates-dir",
        str(TEMPLATES),
        "-q",
        "-s",
        "run",
    ]
    if wallpaper and Path(wallpaper).is_file():
        cmd.append(wallpaper)
    else:
        if wallpaper:
            warn(f"wallpaper missing: {wallpaper}")
        raise ThemeError("no usable wallpaper; run 'duhtheme wallpaper <path>' first")

    ok, detail = _run(cmd, timeout=60)
    if not ok:
        raise ThemeError(f"wallust failed: {detail}")


def read_colors() -> dict[str, str]:
    """Read the wallust-generated palette."""
    try:
        raw = json.loads(COLORS_FILE.read_text())
    except FileNotFoundError:
        raise ThemeError(f"palette not generated: {COLORS_FILE}") from None
    except json.JSONDecodeError as exc:
        raise ThemeError(f"palette is not valid JSON: {exc}") from None
    except OSError as exc:
        raise ThemeError(f"cannot read palette: {exc}") from None

    missing = [k for k in ("background", "foreground", *COLOR_SLOTS) if k not in raw]
    if missing:
        raise ThemeError(f"palette missing keys: {', '.join(missing)}")
    return raw


def build_tokens(
    profile: dict[str, Any], animation: dict[str, Any], colors: dict[str, str], state: State
) -> dict[str, Any]:
    """Merge profile metadata, animation preset and palette into the token document."""
    background = colors["background"]
    foreground = colors["foreground"]
    color_cfg = profile["color"]

    steps = color_cfg.get("surface_steps", [0.0, 0.04, 0.09, 0.14, 0.20])
    surfaces = [_tint(background, float(step)) for step in steps]

    accent = colors.get(color_cfg.get("accent", "color12"), colors["color4"])
    accent_alt = colors.get(color_cfg.get("accent_alt", "color13"), accent)

    blend = float(color_cfg.get("semantic_blend", 0.15))
    semantic = {
        name: _blend(anchor, accent, blend) for name, anchor in SEMANTIC_ANCHORS.items()
    }
    for name, value in semantic.items():
        override = color_cfg.get(name)
        if isinstance(override, str):
            semantic[name] = colors.get(override, override)
        ratio = _contrast(semantic[name], background)
        if ratio < 3.0:
            semantic[name] = _blend(semantic[name], foreground, 0.35)
            warn(f"semantic colour {name!r} had {ratio:.2f}:1 on background; lightened")

    ratio = _contrast(foreground, background)
    if ratio < 4.5:
        warn(f"foreground/background contrast is {ratio:.2f}:1 (below 4.5:1)")

    return {
        "version": 1,
        "profile": profile["meta"]["name"],
        "animation": animation["meta"]["name"],
        "wallpaper": state.wallpaper,
        "meta": profile["meta"],
        "color": {
            **{slot: colors[slot] for slot in COLOR_SLOTS},
            "background": background,
            "foreground": foreground,
            "cursor": colors.get("cursor", foreground),
            "accent": accent,
            "accent_alt": accent_alt,
            **semantic,
            "urgent": semantic["error"],
            "surface": surfaces,
            "on_surface": foreground,
            "contrast": round(ratio, 2),
        },
        "toolkit": profile["toolkit"],
        **_semantic(profile, animation),
        "shell": profile["shell"],
        "animations": {
            "enabled": animation["meta"].get("enabled", True),
            "curves": animation.get("curves", {}),
            "leaves": animation.get("animations", {}),
        },
    }


def _semantic(profile: dict[str, Any], animation: dict[str, Any]) -> dict[str, Any]:
    """Widen the authored shape/spacing/effect sections with the keys the shell consumes."""
    shape, spacing, effect = profile["shape"], profile["spacing"], profile["effect"]
    enabled = animation["meta"].get("enabled", True)
    fade = animation.get("animations", {}).get("fade", {})
    try:
        duration = round(float(fade.get("speed", 1.5)) * 100) if enabled else 0
    except (TypeError, ValueError):
        raise SystemExit(f"animation '{animation['meta']['name']}' has a non-numeric fade speed")

    return {
        "font": {
            **profile["font"],
            "bar_size": profile["font"].get("bar_size", profile["font"]["ui_size"] + 2),
            "glyph": profile["font"].get("glyph", "JetBrainsMono Nerd Font"),
        },
        "shape": {
            **shape,
            "radius_md": shape["radius"],
            "border_width": shape["border"],
            "pill": 9999,
        },
        "spacing": {
            **spacing,
            "xs": spacing["gap_in"],
            "sm": spacing["pad"],
            "md": spacing["pad"] + spacing["gap_out"],
            "lg": spacing["pad"] * 2,
        },
        "effect": {**effect, "transition_ms": duration},
    }


def write_tokens(tokens: dict[str, Any]) -> None:
    """Persist the token document consumed by every downstream config."""
    _write_atomic(TOKENS_FILE, json.dumps(tokens, indent=2) + "\n")


def _gtk_settings(tokens: dict[str, Any]) -> str:
    tk, font = tokens["toolkit"], tokens["font"]
    return (
        "[Settings]\n"
        f"gtk-theme-name={tk['gtk']}\n"
        f"gtk-icon-theme-name={tk['icons']}\n"
        f"gtk-cursor-theme-name={tk['cursor']}\n"
        f"gtk-cursor-theme-size={tk['cursor_size']}\n"
        f"gtk-font-name={font['ui']} {font['ui_size']}\n"
        "gtk-application-prefer-dark-theme=1\n"
    )


def _kitty_theme(tokens: dict[str, Any]) -> str:
    font, color, effect = tokens["font"], tokens["color"], tokens["effect"]
    lines = [
        f"font_family {font['mono']}",
        f"font_size {font['mono_size']}",
        f"background_opacity {effect['surface_alpha']}",
        f"foreground {color['foreground']}",
        f"background {color['background']}",
        f"cursor {color['cursor']}",
        f"selection_background {color['accent']}",
        f"selection_foreground {color['background']}",
    ]
    for index, slot in enumerate(COLOR_SLOTS):
        lines.append(f"color{index} {color[slot]}")
    return "\n".join(lines) + "\n"


def _hyprlang_theme(tokens: dict[str, Any]) -> str:
    color, font = tokens["color"], tokens["font"]
    lines = [f"$font = {font['ui']}", f"$mono = {font['mono']}"]
    for slot in COLOR_SLOTS:
        lines.append(f"${slot} = rgb({color[slot].lstrip('#')})")
    for name in ("background", "foreground", "cursor", "accent", "accent_alt", "error"):
        lines.append(f"${name} = rgb({color[name].lstrip('#')})")
    for index, value in enumerate(color["surface"]):
        lines.append(f"$surface{index} = rgb({value.lstrip('#')})")
    return "\n".join(lines) + "\n"


def _qt_conf(tokens: dict[str, Any], scheme_path: Path) -> str:
    tk, font = tokens["toolkit"], tokens["font"]
    mono = f'"{font["mono"]},{font["mono_size"]},-1,5,50,0,0,0,0,0,Regular"'
    ui = f'"{font["ui"]},{font["ui_size"]},-1,5,50,0,0,0,0,0,Regular"'
    return (
        "[Appearance]\n"
        f"color_scheme_path={scheme_path}\n"
        "custom_palette=true\n"
        "standard_dialogs=default\n"
        f"style={tk['qt_style']}\n"
        f"icon_theme={tk['icons']}\n"
        "\n[Fonts]\n"
        f"fixed={mono}\n"
        f"general={ui}\n"
        "\n[Interface]\n"
        "activate_item_on_single_click=1\n"
        "buttonbox_layout=0\n"
        "cursor_flash_time=1000\n"
        "dialog_buttons_have_icons=1\n"
        "double_click_interval=400\n"
        "gui_effects=@Invalid()\n"
        "keyboard_scheme=2\n"
        "menus_have_icons=true\n"
        "show_shortcuts_in_context_menus=true\n"
        "stylesheets=@Invalid()\n"
        "toolbutton_style=4\n"
        "underline_shortcut=1\n"
        "wheel_scroll_lines=3\n"
        "\n[Troubleshooting]\n"
        "force_raster_widgets=1\n"
        "ignored_applications=@Invalid()\n"
    )


def _lua_literal(value: Any, indent: int = 0) -> str:
    pad = "    " * indent
    inner = "    " * (indent + 1)
    if isinstance(value, dict):
        if not value:
            return "{}"
        items = [f"{inner}{_lua_key(k)} = {_lua_literal(v, indent + 1)}," for k, v in value.items()]
        return "{\n" + "\n".join(items) + f"\n{pad}}}"
    if isinstance(value, (list, tuple)):
        if not value:
            return "{}"
        items = [f"{inner}{_lua_literal(v, indent + 1)}," for v in value]
        return "{\n" + "\n".join(items) + f"\n{pad}}}"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if value is None:
        return "nil"
    escaped = str(value).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def _lua_key(key: str) -> str:
    if key.isidentifier() and not key[0].isdigit():
        return key
    return f'["{key}"]'


def write_consumers(tokens: dict[str, Any]) -> None:
    """Generate every downstream config file from the token document."""
    home = Path.home()
    gtk = _gtk_settings(tokens)
    for version in ("gtk-3.0", "gtk-4.0"):
        _write_atomic(home / ".config" / version / "settings.ini", gtk)

    _write_atomic(home / ".config" / "kitty" / "theme.conf", _kitty_theme(tokens))
    _write_atomic(CACHE / "tokens.lua", f"return {_lua_literal(tokens)}\n")
    _write_atomic(CACHE / "hyprland-theme.conf", _hyprlang_theme(tokens))

    for qt in ("qt5ct", "qt6ct"):
        scheme = home / ".config" / qt / "colors" / "wallust.conf"
        _write_atomic(home / ".config" / qt / f"{qt}.conf", _qt_conf(tokens, scheme))

    kvantum = tokens["toolkit"].get("kvantum")
    if kvantum:
        _write_atomic(
            home / ".config" / "Kvantum" / "kvantum.kvconfig",
            f"[General]\ntheme={kvantum}\n",
        )


def reload_consumers(tokens: dict[str, Any]) -> None:
    """Signal running applications to pick up the new theme, tolerating absent ones."""
    tk, font = tokens["toolkit"], tokens["font"]
    gsettings = [
        ("gtk-theme", tk["gtk"]),
        ("icon-theme", tk["icons"]),
        ("cursor-theme", tk["cursor"]),
        ("font-name", f"{font['ui']} {font['ui_size']}"),
        ("color-scheme", "prefer-dark"),
    ]
    for key, value in gsettings:
        ok, detail = _run(["gsettings", "set", "org.gnome.desktop.interface", key, str(value)])
        if not ok:
            warn(detail)

    for cmd in (
        ["hyprctl", "reload"],
        ["hyprctl", "setcursor", tk["cursor"], str(tk["cursor_size"])],
    ):
        ok, detail = _run(cmd)
        if not ok:
            warn(detail)

    ok, detail = _run(["pkill", "-USR1", "kitty"])
    if not ok and "exited 1" not in detail:
        warn(detail)


def apply(profile_name: str, *, animation_name: str | None = None) -> int:
    """Apply a profile end to end and reload every consumer."""
    state = State.load()
    profile = load_profile(profile_name)
    requested = animation_name or profile.get("animation", {}).get("preset") or "snappy"
    animation = load_animation(requested)
    preset = animation["meta"]["name"]

    run_wallust(profile, state.wallpaper)
    colors = read_colors()

    state = State(profile=profile_name, animation=preset, wallpaper=state.wallpaper)
    tokens = build_tokens(profile, animation, colors, state)

    write_tokens(tokens)
    write_consumers(tokens)
    state.save()
    reload_consumers(tokens)

    info(f"applied profile {profile_name!r} with animation {preset!r}")
    return 0


def set_wallpaper(path: str) -> int:
    """Set the wallpaper, regenerate the palette and reapply the active profile."""
    target = Path(path).expanduser().resolve()
    if not target.is_file():
        raise ThemeError(f"wallpaper not found: {target}")

    ok, detail = _run(["awww", "img", str(target)], timeout=20)
    if not ok:
        warn(f"wallpaper daemon: {detail}")

    state = State.load()
    State(profile=state.profile, animation=state.animation, wallpaper=str(target)).save()
    return apply(state.profile, animation_name=state.animation)


def cmd_list() -> int:
    """Print available profiles and animations as JSON for the launcher."""
    payload: dict[str, Any] = {"profiles": [], "animations": []}
    for name in available_profiles():
        try:
            meta = load_profile(name)["meta"]
        except ThemeError as exc:
            warn(str(exc))
            continue
        payload["profiles"].append(
            {
                "name": name,
                "label": meta.get("label", name),
                "description": meta.get("description", ""),
                "icon": meta.get("icon", ""),
            }
        )
    for name in available_animations():
        meta = load_animation(name)["meta"]
        payload["animations"].append(
            {
                "name": name,
                "label": meta.get("label", name),
                "description": meta.get("description", ""),
            }
        )
    print(json.dumps(payload, indent=2))
    return 0


def main(argv: list[str] | None = None) -> int:
    """Entry point."""
    parser = argparse.ArgumentParser(prog="duhtheme", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p_apply = sub.add_parser("apply", help="switch to a profile")
    p_apply.add_argument("profile")
    p_apply.add_argument("--animation")

    sub.add_parser("reload", help="regenerate using the active profile")

    p_anim = sub.add_parser("animation", help="switch animation preset")
    p_anim.add_argument("preset")

    p_wall = sub.add_parser("wallpaper", help="set wallpaper and regenerate")
    p_wall.add_argument("path")

    sub.add_parser("list", help="list profiles and animations as JSON")
    sub.add_parser("current", help="print the active profile name")

    args = parser.parse_args(argv)

    try:
        match args.command:
            case "apply":
                return apply(args.profile, animation_name=args.animation)
            case "reload":
                state = State.load()
                return apply(state.profile, animation_name=state.animation)
            case "animation":
                state = State.load()
                return apply(state.profile, animation_name=args.preset)
            case "wallpaper":
                return set_wallpaper(args.path)
            case "list":
                return cmd_list()
            case "current":
                print(State.load().profile)
                return 0
        return 2
    except ThemeError as exc:
        print(f"duhtheme: error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
