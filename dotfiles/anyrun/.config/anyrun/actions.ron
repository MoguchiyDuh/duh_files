Config(
  // Built-in power actions are replaced by explicit ones below for
  // full control over commands, icons and confirmation prompts.
  enable_power_actions: false,
  custom_actions: [
    // ---- Session / power ----
    (
      title: "Lock Screen",
      command: "hyprlock",
      description: "Lock the session",
      icon: "system-lock-screen",
    ),
    (
      title: "Suspend",
      command: "systemctl suspend",
      description: "Sleep the machine",
      icon: "system-suspend",
    ),
    (
      title: "Reboot",
      command: "systemctl reboot",
      description: "Restart the machine",
      icon: "system-reboot",
      confirm: true,
    ),
    (
      title: "Shut Down",
      command: "systemctl poweroff",
      description: "Power off the machine",
      icon: "system-shutdown",
      confirm: true,
    ),
    (
      title: "Log Out",
      command: "hyprctl dispatch exit",
      description: "Exit the Hyprland session",
      icon: "system-log-out",
      confirm: true,
    ),
    (
      title: "Power Menu",
      command: "wlogout",
      description: "Open the wlogout power menu",
      icon: "system-shutdown",
    ),

    // ---- Settings (open GUI apps; dispatcher picks the installed tool) ----
    (
      title: "Wi-Fi Settings",
      command: "~/.config/anyrun/scripts/dispatch.sh wifi",
      description: "Manage network connections",
      icon: "network-wireless",
    ),
    (
      title: "Bluetooth Settings",
      command: "~/.config/anyrun/scripts/dispatch.sh bluetooth",
      description: "Manage Bluetooth devices",
      icon: "bluetooth",
    ),
    (
      title: "Audio Settings",
      command: "~/.config/anyrun/scripts/dispatch.sh audio",
      description: "Output, input and per-app volume",
      icon: "audio-volume-high",
    ),
    (
      title: "Display Settings",
      command: "~/.config/anyrun/scripts/dispatch.sh display",
      description: "Arrange monitors, resolution and scale",
      icon: "video-display",
    ),
    (
      title: "Power Profile: Eco",
      command: "~/.config/hypr/scripts/power.sh profile eco",
      description: "Battery saver (power-saver)",
      icon: "battery-level-20-symbolic",
    ),
    (
      title: "Power Profile: Balanced",
      command: "~/.config/hypr/scripts/power.sh profile balanced",
      description: "Default balanced profile",
      icon: "battery-level-70-symbolic",
    ),
    (
      title: "Power Profile: Performance",
      command: "~/.config/hypr/scripts/power.sh profile performance",
      description: "Maximum performance",
      icon: "battery-level-100-charging-symbolic",
    ),
    (
      title: "Keep Awake: Toggle",
      command: "~/.config/hypr/scripts/power.sh awake toggle",
      description: "Toggle idle/sleep inhibition",
      icon: "preferences-desktop-screensaver",
    ),

    // ---- Screen capture ----
    (
      title: "Screenshot: Fullscreen",
      command: "~/.config/hypr/scripts/screenshot.sh fullscreen",
      description: "Capture the whole screen",
      icon: "applets-screenshooter",
    ),
    (
      title: "Screenshot: Area",
      command: "~/.config/hypr/scripts/screenshot.sh area",
      description: "Select a region to capture",
      icon: "applets-screenshooter",
    ),
    (
      title: "Screenshot: Window",
      command: "~/.config/hypr/scripts/screenshot.sh active",
      description: "Capture the active window",
      icon: "applets-screenshooter",
    ),
    (
      title: "Screen Record: Toggle",
      command: "~/.config/anyrun/scripts/dispatch.sh record",
      description: "Start or stop screen recording",
      icon: "media-record",
    ),

    // ---- Tools ----
    (
      title: "Wallpaper Picker",
      command: "~/.config/anyrun/scripts/wallpaper.sh",
      description: "Pick a wallpaper and recolor the theme",
      icon: "preferences-desktop-wallpaper",
    ),
    (
      title: "Color Picker",
      command: "~/.config/anyrun/scripts/dispatch.sh color-picker",
      description: "Pick a screen color to the clipboard",
      icon: "color-picker",
    ),
    (
      title: "OCR: Screen Region",
      command: "~/.config/anyrun/scripts/ocr.sh",
      description: "Extract text from a screen region",
      icon: "accessories-character-map",
    ),
  ],
)
